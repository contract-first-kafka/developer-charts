{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["systemName", "resourceName", "clusterName", "kafkaVersion", "replicas", "storage"],
  "properties": {
    "clusterName": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 50},
    "kafkaVersion": {"type": "string", "pattern": "^4\\.2\\.[0-9]+$"},
    "replicas": {"type": "integer", "enum": [1, 3]},
    "storage": {
      "type": "object", "required": ["size", "deleteClaim"],
      "properties": {
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Gi|Ti)$"},
        "storageClass": {"type": "string"}, "deleteClaim": {"type": "boolean"}
      }
    }
  }
}
